{
  "name": "showcord",
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "start": "vite",
    "dev": "vite",
    "build": "tsc && vite build",
    "serve": "vite preview",
    "lint": "eslint",
    "lint:fix": "eslint --fix",
    "test": "npm run test:strict",
    "test:strict": "vitest --run --coverage --silent passed-only",
    "test:integration": "vitest --run test/integration --silent passed-only",
    "test:unit": "vitest --run test/unit test/ui --silent passed-only",
    "test:ui": "vitest --run test/ui-snapshot.test.tsx --silent passed-only",
    "test:watch": "vitest --ui",
    "test:ci": "vitest --run --coverage --bail 1",
    "pre-commit": "npm run lint:fix && npm run test && npm run build",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/modifiers": "^9.0.0",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@fontsource/roboto-mono": "^5.3.0",
    "@fortawesome/fontawesome-svg-core": "^7.3.1",
    "@fortawesome/free-solid-svg-icons": "^7.3.1",
    "@fortawesome/react-fontawesome": "^3.5.0",
    "@pkmn/client": "^0.7.3",
    "@pkmn/data": "^0.10.11",
    "@pkmn/dex": "^0.10.11",
    "@pkmn/img": "^0.3.4",
    "@pkmn/protocol": "^0.7.3",
    "@pkmn/view": "^0.7.3",
    "@radix-ui/react-icons": "^1.3.2",
    "@radix-ui/react-label": "^2.1.15",
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-switch": "^1.3.7",
    "@radix-ui/react-toast": "^1.2.23",
    "@vercel/analytics": "^2.0.1",
    "@vitest/coverage-v8": "^4.1.10",
    "allotment": "^1.20.5",
    "axios": "^1.19.0",
    "buffer": "^6.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "framer-motion": "^12.43.0",
    "highlight.js": "^11.11.1",
    "html-escaper": "^3.0.3",
    "html-react-parser": "^6.1.5",
    "immer": "^11.1.15",
    "jquery": "^4.0.0",
    "linkify-react": "^4.3.3",
    "linkifyjs": "^4.3.3",
    "minisearch": "^7.2.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-error-boundary": "^6.1.2",
    "react-icons": "^5.7.0",
    "react-innertext": "^1.1.5",
    "react-loader-spinner": "^8.0.2",
    "react-textarea-autosize": "^8.5.9",
    "sanitize-html-react": "^1.13.0",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "vite-plugin-pwa": "^1.3.0",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@eslint-react/eslint-plugin": "^5.18.1",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/html-escaper": "^3.0.4",
    "@types/jquery": "^4.0.1",
    "@types/node": "^25.4.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@typescript-eslint/eslint-plugin": "^8.66.0",
    "@typescript-eslint/parser": "^8.66.0",
    "@vitejs/plugin-react": "^6.0.5",
    "@vitest/ui": "^4.1.10",
    "eslint": "^10.8.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "eslint-plugin-regexp": "^3.1.1",
    "happy-dom": "^20.11.1",
    "rollup-plugin-node-polyfills": "^0.2.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.66.0",
    "vite": "^8.2.0",
    "vite-plugin-svgr": "^5.2.0",
    "vitest": "^4.1.10"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "trustedDependencies": [
    "@fortawesome/fontawesome-common-types",
    "@fortawesome/fontawesome-svg-core",
    "@fortawesome/free-solid-svg-icons",
    "@swc/core",
    "core-js"
  ]
}
